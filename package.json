{
  "name": "founder-math",
  "version": "0.1.0",
  "description": "Tested, zero-dependency startup finance math: post-money SAFEs, dilution, runway and reverse ARR targets.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "founder-math": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test",
    "build:web": "tsc && node -e \"require('fs').cpSync('dist','web/dist',{recursive:true})\"",
    "web": "npm run build:web && node scripts/serve.mjs"
  },
  "keywords": [
    "startup",
    "safe",
    "y-combinator",
    "cap-table",
    "dilution",
    "runway",
    "finance"
  ],
  "license": "MIT",
  "author": "Daniel Nguyen",
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
